{
  "name": "granule-trader",
  "version": "0.1.0",
  "description": "Desktop trading app for a plastic granules business",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "predev": "npm run rebuild:electron",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "prestart": "npm run rebuild:electron",
    "test": "vitest run",
    "pretest": "npm run rebuild:node",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "rebuild:electron": "electron-rebuild -w better-sqlite3",
    "rebuild:node": "npm rebuild better-sqlite3",
    "postinstall": "npm run rebuild:electron"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@testing-library/react": "^16.0.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.0.0",
    "electron-vite": "^2.3.0",
    "jsdom": "^24.1.0",
    "postcss": "^8.5.15",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@mantine/core": "^7.17.8",
    "@mantine/dates": "^7.17.8",
    "@mantine/form": "^7.17.8",
    "@mantine/hooks": "^7.17.8",
    "@mantine/notifications": "^7.17.8",
    "@tabler/icons-react": "^3.44.0",
    "better-sqlite3": "^11.1.2",
    "dayjs": "^1.11.21",
    "india-pincode-lookup": "^1.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.24.0"
  }
}
